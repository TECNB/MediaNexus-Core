APP_NAME=MediaNexus API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./app.db
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

RADARR_SCHEME=http
RADARR_HOST=127.0.0.1
RADARR_PORT=7878
RADARR_API_KEY=your_radarr_api_key
RADARR_TIMEOUT=10

SONARR_SCHEME=http
SONARR_HOST=127.0.0.1
SONARR_PORT=8989
SONARR_API_KEY=your_sonarr_api_key
SONARR_TIMEOUT=10

SUBTITLE_SSH_HOST=your-media-server-host
SUBTITLE_SSH_PORT=22
SUBTITLE_SSH_USERNAME=your-ssh-user
SUBTITLE_SSH_PASSWORD=your-ssh-password
SUBTITLE_SSH_TIMEOUT=10
SUBTITLE_MAX_UPLOAD_MB=100
SUBTITLE_SSH_KEY_PATH=/path/to/your/private/key
SUBTITLE_SSH_USE_KEY=false
